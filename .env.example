# Base URL of the SwiftAgents backend the proxy forwards WebMCP calls to
SWIFTAGENT_API_URL=http://localhost:8000/api/v1

# Sent upstream as X-API-Key when the incoming request doesn't carry one.
# Stays server-side — it is never bundled into the React app.
BEARER_TOKEN=

# Port the Express proxy listens on (default 8001)
PORT=8001
